          "url": "",
          "auth_header": "Authorization",
          "auth_prefix": ""
        }
      }
    },
    "tdx": {
      "enabled": true,
      "api_key_env": "TDX_API_KEY",
      "timeout_seconds": 60,
      "mcp_servers": {
        "stock_data": {
          "url": "",
          "auth_header": "Authorization",
          "auth_prefix": "Bearer "
        }
      }
    },
    "choice": {
      "enabled": true,
      "api_key_env": "CHOICE_MX_KEY",
